# MediCore Frontend Environment Variables Configuration
# In production on Render (single web service), leave these empty to auto-use same-origin:
# VITE_API_URL=/api/v1
# VITE_SOCKET_URL=

# If deploying frontend separately (e.g. Vercel) pointing to Render backend:
# VITE_API_URL=https://ai-powered-hospital.onrender.com/api/v1
# VITE_SOCKET_URL=https://ai-powered-hospital.onrender.com

# Local development defaults
VITE_API_URL=/api/v1
VITE_SOCKET_URL=http://localhost:5000
