# ==============================================================================
# MediCore Frontend Client .gitignore (React + Vite + TypeScript + TailwindCSS)
# ==============================================================================

# Dependencies
node_modules/

# Production build output
dist/
dist-ssr/

# Environment files with secrets (keep .env.example trackable)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Vite cache & temp files
.vite/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

